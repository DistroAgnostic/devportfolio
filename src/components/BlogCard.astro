---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  slug: string;
}

const { title, description, pubDate, updatedDate, tags, slug } = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdatedDate = updatedDate
  ? updatedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<a
  href={`/blog/${slug}`}
  class="block group"
>
  <article class="glass-card glow-hover rounded-xl p-6 sm:p-8">
    <div class="space-y-3">
      <div class="flex items-center gap-3 text-sm" style="color: var(--text-muted)">
        <time datetime={pubDate.toISOString()}>
          {formattedPubDate}
        </time>
        {
          formattedUpdatedDate && formattedUpdatedDate !== formattedPubDate && (
            <span class="flex items-center gap-1" style="color: var(--accent)">
              <span aria-hidden="true">·</span>
              <span>Updated {formattedUpdatedDate}</span>
            </span>
          )
        }
      </div>

      <h3 class="text-xl sm:text-2xl font-bold transition-colors duration-300 group-hover:text-[var(--accent)]" style="color: var(--text-primary)">
        {title}
      </h3>

      <p class="text-base leading-relaxed" style="color: var(--text-secondary)">
        {description}
      </p>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {tags.map((tag) => (
              <span class="tech-badge">{tag}</span>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-5 flex items-center gap-2 text-sm font-medium transition-all duration-300 group-hover:gap-3" style="color: var(--accent)">
      Read more
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </article>
</a>