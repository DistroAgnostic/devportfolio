<div class="anon-comments-wrapper mt-8">
  <button
    id="anon-toggle"
    class="anon-toggle-btn"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
      <line x1="12" y1="9" x2="12" y2="13" />
      <line x1="12" y1="17" x2="12.01" y2="17" />
    </svg>
    <span>Comment Anonymously</span>
    <svg id="anon-chevron" class="anon-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>

  <div id="anon-warning" class="anon-warning-dialog" style="display:none">
    <div class="dialog-backdrop"></div>
    <div class="dialog-panel glass-card">
      <div class="dialog-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
      </div>
      <h4 class="dialog-title">Anonymous Comments</h4>
      <p class="dialog-text">
        Anonymous comments are <strong>manually reviewed</strong> before publication
        and will not appear immediately. This may take hours or days depending on
        moderation availability.
      </p>
      <p class="dialog-text" style="color: var(--text-muted); font-size: 0.8125rem;">
        We recommend signing in with your GitHub account for instant, real-time discussion
        with reactions and replies.
      </p>
      <div class="dialog-actions">
        <button id="goto-giscus" class="dialog-btn dialog-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
          </svg>
          Comment with GitHub Login
        </button>
        <button id="proceed-anon" class="dialog-btn dialog-btn-ghost">
          Comment Anyway
        </button>
      </div>
    </div>
  </div>

  <div id="anon-form" class="anon-form-section" style="display:none">
    <div class="anon-warning-banner">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
      <span>Comments are manually reviewed and may not appear immediately. Spam will be deleted.</span>
    </div>
    <div id="cusdis_thread" class="mt-4"></div>
  </div>
</div>

<script is:inline>
  let cusdisLoaded = false;

  function loadCusdis() {
    if (cusdisLoaded) return;
    cusdisLoaded = true;

    const thread = document.getElementById("cusdis_thread");
    if (!thread) return;

    const pageId = window.location.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
    const pageUrl = window.location.origin + window.location.pathname;
    const pageTitle = document.title || "Blog Post";

    thread.setAttribute("data-host", "https://cusdis.com");
    thread.setAttribute("data-app-id", "ce48f40c-10e9-4255-9935-44911a3139bf");
    thread.setAttribute("data-page-id", pageId);
    thread.setAttribute("data-page-url", pageUrl);
    thread.setAttribute("data-page-title", pageTitle);
    thread.setAttribute("data-theme", "dark");

    const script = document.createElement("script");
    script.src = "https://cusdis.com/js/cusdis.es.js";
    script.async = true;
    script.defer = true;
    document.body.appendChild(script);
  }

  function openWarningDialog() {
    const warning = document.getElementById("anon-warning");
    const form = document.getElementById("anon-form");
    if (warning) warning.style.display = "flex";
    if (form) form.style.display = "none";
    document.body.style.overflow = "hidden";
  }

  function closeWarningDialog() {
    const warning = document.getElementById("anon-warning");
    document.body.style.overflow = "";
    if (warning) warning.style.display = "none";
  }

  function showAnonForm() {
    closeWarningDialog();
    const form = document.getElementById("anon-form");
    if (form) form.style.display = "block";
    loadCusdis();
  }

  function scrollToGiscus() {
    closeWarningDialog();
    const giscus = document.getElementById("giscus-comments");
    if (giscus) {
      giscus.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }

  document.getElementById("anon-toggle")?.addEventListener("click", () => {
    openWarningDialog();
  });

  document.getElementById("goto-giscus")?.addEventListener("click", () => {
    scrollToGiscus();
  });

  document.getElementById("proceed-anon")?.addEventListener("click", () => {
    showAnonForm();
  });

  document.querySelector(".dialog-backdrop")?.addEventListener("click", () => {
    closeWarningDialog();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeWarningDialog();
  });
</script>