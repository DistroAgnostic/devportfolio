---
import { getCollection } from "astro:content";
import GiscusComments from "../../components/GiscusComments.astro";
import AnonComments from "../../components/AnonComments.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => import.meta.env.PROD ? !post.data.draft : true)
    .map((post) => ({
      params: { slug: post.slug ?? post.id.replace(/\.md$/, "") },
    }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find((p) => (p.slug ?? p.id.replace(/\.md$/, "")) === slug);

if (!post) {
  return Astro.redirect("/blog");
}
const { title, pubDate, updatedDate, description, tags } = post.data;

const contentHtml = post.rendered?.html ?? "";

const formattedPubDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const showUpdated =
  updatedDate &&
  updatedDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }) !== formattedPubDate;

const formattedUpdatedDate = updatedDate
  ? updatedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#06060e" />

    <meta property="og:title" content={`${title} — ${siteConfig.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://justchetan.me/blog/${slug}`} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title} — {siteConfig.name}</title>
  </head>
  <body>
    <div class="grid-overlay"></div>
    <div class="orb-3"></div>

    <Header currentPath="/blog" />
    <main>
      <article class="relative z-10 mx-auto max-w-3xl px-6 sm:px-8 py-24 sm:py-32 lg:py-40">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-medium mb-8 transition-colors duration-300 hover:text-[var(--accent)]"
          style="color: var(--text-muted)"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          All posts
        </a>

        <header class="mb-10">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight" style="color: var(--text-primary)">
            {title}
          </h1>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-sm" style="color: var(--text-muted)">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <time datetime={pubDate.toISOString()}>Published {formattedPubDate}</time>
            </div>

            {
              showUpdated && (
                <div class="flex items-center gap-2" style="color: var(--accent)">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  <time datetime={updatedDate!.toISOString()}>Updated {formattedUpdatedDate}</time>
                </div>
              )
            }
          </div>

          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {tags.map((tag) => (
                  <span class="tech-badge">{tag}</span>
                ))}
              </div>
            )
          }
        </header>

        <div class="blog-content" set:html={contentHtml}>
        </div>

        <div class="mt-16 pt-8" style="border-top: 1px solid var(--glass-border)">
          <GiscusComments />
          <AnonComments />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>